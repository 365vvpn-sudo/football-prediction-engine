# ==========================================
# Football Prediction Engine - Environment
# ==========================================

# Application
APP_ENV=development
APP_NAME=football-prediction
LOG_LEVEL=INFO
TIMEZONE=UTC

# Database
DATABASE_URL=

# Redis / Cache
REDIS_URL=

# API
API_HOST=0.0.0.0
API_PORT=8000

# Football Data Sources
SOFASCORE_API_URL=
FOTMOB_API_URL=
UNDERSTAT_API_URL=

# Odds
ODDS_API_KEY=

# News
NEWS_API_KEY=

# Machine Learning
ML_MODEL_VERSION=
ML_ENABLED=true

# Integrity / Risk
INTEGRITY_CHECK_ENABLED=true

# Decision Engine
DECISION_ENGINE_VERSION=1.0.0
